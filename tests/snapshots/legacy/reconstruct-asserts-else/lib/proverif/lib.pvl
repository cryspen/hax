(*
  Run with:
    proverif -lib <hax>/hax-lib/proof-libs/proverif/primitives.pvl lib.pvl

  primitives.pvl ships with hax and declares the symbols this file
  uses but does not define: the public channel c, the construct_fail
  sink, bitstring_default and bitstring_err, the Some/None and
  True/False constructors, the nat_N literal constants, logical_and
  and logical_or, and the rust_primitives, core, and hax_lib opaque
  functions.

  A symbol this file uses that is defined neither here nor in
  primitives.pvl is listed in missingdecl.pvl, a diagnostic that is
  not part of the model. Define each such symbol — by hand or from
  another crate's extraction — or leave it abstract as an
  ideal-functionality boundary.
*)

(* src: src/legacy/reconstruct-asserts-else/lib.rs:7:0-9:1 new_tests__legacy__reconstruct_asserts_else__lib__checked_incr *)
(*  Value in the else branch. *)
letfun new_tests__legacy__reconstruct_asserts_else__lib__checked_incr(c: bitstring, x: bitstring) =
  let (=True()) = c in bitstring_err() else rust_primitives__hax__machine_int__add(x, nat_1).
(* src: src/legacy/reconstruct-asserts-else/lib.rs:12:0-20:1 new_tests__legacy__reconstruct_asserts_else__lib__nested *)
(*  Nested panic-elses. *)
letfun new_tests__legacy__reconstruct_asserts_else__lib__nested(
  c: bitstring,
  d: bitstring,
  x: bitstring
) = let (=True()) = c in bitstring_err() else (let (=True()) = d in bitstring_err() else x).
(* src: src/legacy/reconstruct-asserts-else/lib.rs:23:0-25:1 new_tests__legacy__reconstruct_asserts_else__lib__bare *)
(*  No else. *)
letfun new_tests__legacy__reconstruct_asserts_else__lib__bare(c: bitstring) =
  let (=True()) = c in bitstring_err() else rust_primitives__hax__Tuple0__Tuple0.