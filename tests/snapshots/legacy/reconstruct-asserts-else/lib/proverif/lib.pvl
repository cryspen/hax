letfun new_tests__legacy__reconstruct_asserts_else__lib__nested(
         c : bool, d : bool, x : nat
       ) =
       if c then (nat_err()) else (if d then (nat_err()) else (x)).

letfun new_tests__legacy__reconstruct_asserts_else__lib__bare(c : bool) =
