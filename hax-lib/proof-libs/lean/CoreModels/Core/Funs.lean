    Source: 'core-models/src/core/num/mod.rs', lines 2011:8-2016:9
    Visibility: public -/
def num.U8.is_ascii_punctuation (x : Std.U8) : Result Bool := do
  if x >= 33#u8
  then
    if x <= 47#u8
    then ok true
    else
      if x >= 58#u8
      then
        if x <= 64#u8
        then ok true
        else
          if x >= 91#u8
          then
            if x <= 96#u8
            then ok true
            else if x >= 123#u8
                 then ok (x <= 126#u8)
                 else ok false
          else if x >= 123#u8
               then ok (x <= 126#u8)
               else ok false
      else
        if x >= 91#u8
        then
          if x <= 96#u8
          then ok true
          else if x >= 123#u8
               then ok (x <= 126#u8)
               else ok false
        else if x >= 123#u8
             then ok (x <= 126#u8)
             else ok false
  else
