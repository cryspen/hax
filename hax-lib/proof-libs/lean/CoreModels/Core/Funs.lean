/-- [core_models::num::{core_models::num::i8}::checked_next_multiple_of]:
    Source: 'core-models/src/core/num/mod.rs', lines 1551:12-1573:13
    Visibility: public -/
def num.I8.checked_next_multiple_of
  (x : Std.I8) (y : Std.I8) : Result (option.Option Std.I8) := do
  if y = (-1)#i8
  then ok (option.Option.Some x)
  else
    if y = 0#i8
    then ok option.Option.None
    else
      let r ← x % y
      let m ←
        if r > 0#i8
        then
          if y < 0#i8
          then num.I8.wrapping_add r y
          else
            if r < 0#i8
            then if y > 0#i8
                 then num.I8.wrapping_add r y
                 else ok r
            else ok r
        else
          if r < 0#i8
          then if y > 0#i8
               then num.I8.wrapping_add r y
               else ok r
          else ok r
      if m = 0#i8
      then ok (option.Option.Some x)
      else let i ← num.I8.wrapping_sub y m
           num.I8.checked_add x i

