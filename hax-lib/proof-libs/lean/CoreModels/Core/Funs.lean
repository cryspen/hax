    Source: 'core-models/src/core/num/mod.rs', lines 1538:12-1549:13
    Visibility: public -/
def num.I8.midpoint (x : Std.I8) (y : Std.I8) : Result Std.I8 := do
  let d ← lift (x ^^^ y)
  let i ← d >>> 1#i32
  let i1 ← lift (x &&& y)
  let t ← num.I8.wrapping_add i i1
  if t < 0#i8
  then let i2 ← lift (d &&& 1#i8)
       num.I8.wrapping_add t i2
  else ok t

