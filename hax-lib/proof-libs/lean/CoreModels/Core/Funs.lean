def num.I8.carrying_mul_add
  (x : Std.I8) (y : Std.I8) (carry : Std.I8) (add : Std.I8) :
  Result (Std.U8 × Std.I8)
  := do
  let (low, high) ← num.I8.widening_mul x y
  let i ← lift (IScalar.hcast .U8 carry)
  let (low1, c1) ← num.U8.overflowing_add low i
  let i1 ← lift (IScalar.hcast .U8 add)
  let (low2, c2) ← num.U8.overflowing_add low1 i1
  let i2 ← if c1
             then ok 1#i8
             else ok 0#i8
  let high1 ← num.I8.wrapping_add high i2
  let i3 ← if c2
             then ok 1#i8
             else ok 0#i8
  let high2 ← num.I8.wrapping_add high1 i3
  let i4 ← if carry < 0#i8
             then ok (-1)#i8
             else ok 0#i8
  let high3 ← num.I8.wrapping_add high2 i4
  let i5 ← if add < 0#i8
             then ok (-1)#i8
             else ok 0#i8
  let high4 ← num.I8.wrapping_add high3 i5
  ok (low2, high4)

