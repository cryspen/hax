**/proofs/lean/extraction/

# Aeneas-extracted output for the two test crates (regenerated each
# build). The hand-written stubs (`FunsExternal.lean`,
# `TypesExternal.lean`) and the entry-point modules (`ClientTest.lean`,
# `RustLeanTests.lean`) stay tracked.
tests/client_test/proofs/lean/ClientTest/Extraction/Funs.lean
tests/client_test/proofs/lean/ClientTest/Extraction/Types.lean
tests/client_test/proofs/lean/ClientTest/Extraction/Specs.lean
tests/client_test/proofs/lean/ClientTest/Extraction/ProofObligations.lean
tests/rust_lean_equiv_test/source/proofs/lean/RustLeanTests/Extraction/Funs.lean
tests/rust_lean_equiv_test/source/proofs/lean/RustLeanTests/Extraction/Types.lean
# `LeanTests.lean` is generated by `gen_lean_tests.py` from the
# `#[rust_lean_test]` attributes in `source/src/**/*.rs`.
tests/rust_lean_equiv_test/source/proofs/lean/RustLeanTests/LeanTests.lean
# Lake's resolver state is regenerated from `lakefile.toml`.
tests/client_test/proofs/lean/lake-manifest.json
tests/rust_lean_equiv_test/source/proofs/lean/lake-manifest.json
# hax generates a `.gitignore` inside each Lean package on every run.
tests/client_test/proofs/lean/.gitignore
tests/rust_lean_equiv_test/source/proofs/lean/.gitignore

